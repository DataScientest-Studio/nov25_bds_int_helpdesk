[Unit]
Description=HelpDesk Performance Monitor (Reflex Dashboard)
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/home/openclaw/.local/bin/start-reflex-helpdesk.sh
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=10
Environment="HOME=/home/openclaw"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reflex-helpdesk

[Install]
WantedBy=default.target
